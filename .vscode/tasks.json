{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Install backend deps",
      "type": "shell",
      "command": "python -m venv .venv && ./.venv/bin/python -m pip install -r requirements.txt",
      "windows": { "command": "python -m venv .venv; .\\.venv\\Scripts\\python -m pip install -r requirements.txt" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "2. Seed demo data",
      "type": "shell",
      "command": "./.venv/bin/python seed.py",
      "windows": { "command": ".\\.venv\\Scripts\\python seed.py" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "3. Install frontend deps",
      "type": "shell",
      "command": "yarn install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Run backend",
      "type": "shell",
      "command": "./.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --reload",
      "windows": { "command": ".\\.venv\\Scripts\\uvicorn server:app --host 0.0.0.0 --port 8001 --reload" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run frontend",
      "type": "shell",
      "command": "yarn dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run BOTH (backend + frontend)",
      "dependsOn": ["Run backend", "Run frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}

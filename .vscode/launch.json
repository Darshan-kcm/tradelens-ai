    {
      "name": "Backend: seed demo data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/seed.py",
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": false
    }
  ],
  "compounds": []
}

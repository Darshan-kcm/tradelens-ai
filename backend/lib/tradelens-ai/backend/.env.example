# Backend configuration — copy this file to backend/.env and adjust

# Database connection (MongoDB in this build; see README section 1)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="tradelens"

# Comma-separated list of allowed browser origins ("*" for local development)
CORS_ORIGINS="*"

# Public URL of the app (only used for links if you add email/sharing later)
APP_URL="http://localhost:3000"

# --- Live data providers ---
# Get a free key (no credit card) at https://twelvedata.com/register
# Powers real prices, OHLCV history and fundamentals. Free tier: 800 calls/day.
TWELVE_DATA_API_KEY=""

# Get a free key at https://www.marketaux.com/
# Powers the News & Sentiment page. Free tier: limited daily requests.
MARKETAUX_API_KEY=""

# Get a free key (no credit card) at https://site.financialmodelingprep.com/
# Powers real fundamentals (market cap, P/E, EPS, ROE, etc.) for US-listed
# stocks only (NASDAQ/NYSE) — free tier: 250 calls/day, US coverage only.
# Indian/other stocks keep clearly-labelled demo fundamentals either way,
# since P/E-style ratios aren't meaningful for indices/forex/commodities/crypto.
FMP_API_KEY=""

# If any key above is left blank, that feature automatically falls back
# to clearly-labelled DEMO data so the app still runs end-to-end.

# Backend configuration — copy to backend/.env and adjust.
# (Same content as backend/.env.example, kept at the root for convenience.)

MONGO_URL="mongodb://localhost:27017"
DB_NAME="tradelens"
CORS_ORIGINS="*"
APP_URL="http://localhost:3000"

# --- Live data providers ---
# Get a free key (no credit card) at https://twelvedata.com/register
TWELVE_DATA_API_KEY=""

# Get a free key at https://www.marketaux.com/
MARKETAUX_API_KEY=""

# Get a free key at https://site.financialmodelingprep.com/
# US-listed stocks only (free tier scope). Powers real fundamentals for
# NASDAQ/NYSE symbols; other symbols keep demo fundamentals either way.
FMP_API_KEY=""

# Leave any blank to fall back to labelled DEMO data automatically.
